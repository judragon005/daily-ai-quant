#!/bin/sh
# ==============================================================================
# 本地 Git Pre-Push 門禁護欄
# 功能：推送前強制驗證本地單元測試，未通過則禁止推播至遠端 GitHub
# ==============================================================================

echo "🔍 [Pre-Push 門禁檢驗] 正在執行本地單元測試..."

# 執行 pytest
python -m pytest tests/
test_status=$?

if [ $test_status -ne 0 ]; then
    echo "===================================================================="
    echo "❌ [推送阻斷] 本地單元測試未通過！"
    echo "👉 請先修復上述測試錯誤，再次嘗試推送。"
    echo "===================================================================="
    exit 1
fi

echo "✅ [Pre-Push 門禁檢驗] 本地單元測試 100% 通過，核准推送！"
exit 0
